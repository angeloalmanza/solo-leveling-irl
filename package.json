{
  "name": "solo-leveling-irl",
  "private": true,
  "workspaces": [
    "mobile",
    "backend",
    "shared"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=mobile",
    "backend": "npm run dev --workspace=backend",
    "build:shared": "npm run build --workspace=@solo/shared",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && tsc -p mobile/tsconfig.json --noEmit",
    "typecheck:backend": "tsc -p backend/tsconfig.json --noEmit",
    "test": "npm run test --workspace=backend"
  },
  "dependencies": {
    "@egjs/hammerjs": "^2.0.17",
    "hoist-non-react-statics": "^3.3.2",
    "invariant": "^2.2.4",
    "react-freeze": "^1.0.4",
    "react-native-is-edge-to-edge": "^1.3.1",
    "semver": "^7.8.1",
    "warn-once": "^0.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.61.0"
  }
}
